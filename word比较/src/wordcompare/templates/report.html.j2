<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root {
    --bg: #ffffff;
    --panel: #f7f8fa;
    --line: #e3e6ec;
    --text: #1f2329;
    --muted: #6b7280;
    --ins-bg: #d9f7e3;
    --ins-fg: #116329;
    --del-bg: #ffe1e4;
    --del-fg: #9b1c2c;
    --accent: #2563eb;
    --warn: #b45309;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.65;
  }
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
    padding: 14px 20px 10px;
  }
  h1 { font-size: 17px; margin: 0 0 6px; font-weight: 600; }
  .files { color: var(--muted); font-size: 12.5px; margin-bottom: 10px; }
  .files code { background: #fff; border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
  .stats { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .chip {
    background: #fff; border: 1px solid var(--line); border-radius: 999px;
    padding: 3px 11px; font-size: 12.5px; color: #374151;
  }
  .chip b { font-weight: 600; color: var(--text); }
  .chip.ins b { color: var(--ins-fg); }
  .chip.del b { color: var(--del-fg); }
  .chip.mod b { color: var(--warn); }
  .toolbar { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; font-size: 13px; color: var(--muted); }
  .toolbar label { display: inline-flex; gap: 6px; align-items: center; cursor: pointer; user-select: none; }
  .toolbar button {
    border: 1px solid var(--line); background: #fff; color: var(--text);
    border-radius: 6px; padding: 3px 10px; cursor: pointer; font-size: 12.5px;
  }
  .toolbar button:hover { border-color: var(--accent); color: var(--accent); }
  .col-heads {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) minmax(0, 1fr);
    gap: 0;
    padding: 8px 20px;
    background: #fbfcfd;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 12.5px;
  }
  main { padding: 0 20px 80px; }
  .row {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) minmax(0, 1fr);
    border-bottom: 1px solid #f0f2f5;
    scroll-margin-top: 190px;
  }
  .row.changed { background: #fffdf5; }
  .row.kind-insert { background: #f4fdf7; }
  .row.kind-delete { background: #fff6f7; }
  .row.flash { animation: flash 1.2s ease-out; }
  @keyframes flash { from { background: #fff3bf; } to { } }
  .gutter {
    font-size: 11px;
    color: #9aa1ac;
    text-align: right;
    padding: 10px 8px 10px 0;
    border-right: 1px solid #f0f2f5;
    user-select: none;
  }
  .gutter .no { display: block; color: var(--accent); font-weight: 600; }
  .cell { padding: 8px 14px; min-width: 0; }
  .cell.left { border-right: 1px dashed #eceff3; }
  .para { margin: 0 0 4px; white-space: normal; overflow-wrap: anywhere; }
  .para.align-center { text-align: center; }
  .para.align-right { text-align: right; }
  .para.align-both { text-align: justify; }
  .style-tag {
    font-size: 10.5px; color: #7c3aed; border: 1px solid #ddd6fe;
    background: #f5f3ff; border-radius: 4px; padding: 0 4px; margin-right: 6px;
    vertical-align: 1px;
  }
  .del { background: var(--del-bg); color: var(--del-fg); text-decoration: line-through; border-radius: 2px; }
  .ins { background: var(--ins-bg); color: var(--ins-fg); text-decoration: underline; border-radius: 2px; }
  .placeholder { color: #c1c6cf; font-style: italic; font-size: 12.5px; }
  .fmt {
    margin-top: 4px; font-size: 11.5px; color: #92400e;
    background: #fffbeb; border: 1px dashed #fcd34d; border-radius: 4px;
    padding: 1px 6px; display: inline-block;
  }
  .badge {
    font-size: 11px; border-radius: 4px; padding: 0 5px; margin-right: 6px;
    border: 1px solid var(--line); background: #fff; color: var(--muted);
  }
  table.diff-table {
    border-collapse: collapse; width: 100%; margin: 2px 0 6px;
    font-size: 13px; table-layout: auto;
  }
  table.diff-table td {
    border: 1px solid #dfe3e8; padding: 4px 7px; vertical-align: top;
    min-width: 60px; overflow-wrap: anywhere;
  }
  tr.trow-insert td { background: #f4fdf7; }
  tr.trow-delete td { background: #fff6f7; }
  tr.trow-modify td { background: #fffef7; }
  td.tcell-changed { outline: 1px solid #fcd34d; outline-offset: -1px; }
  td.merged { background: #fafbfc; }
  .hidden { display: none !important; }
  .empty-note { padding: 40px 20px; color: var(--muted); text-align: center; }
  @media print { header { position: static; } .row { page-break-inside: avoid; } }
</style>
</head>
<body>
<header>
  <h1>{{ title }}</h1>
  <div class="files">
    基准：<code>{{ left_name }}</code>
    &nbsp;→&nbsp; 对比：<code>{{ right_name }}</code>
  </div>
  <div class="stats">
    <span class="chip">整体相似度 <b>{{ "%.1f"|format(stats.similarity * 100) }}%</b></span>
    <span class="chip ins">新增 <b>{{ stats.inserted }}</b></span>
    <span class="chip del">删除 <b>{{ stats.deleted }}</b></span>
    <span class="chip mod">修改 <b>{{ stats.modified }}</b></span>
    {% if has_format %}<span class="chip">格式变更 <b>{{ stats.format_changes }}</b></span>{% endif %}
    <span class="chip">表格变更 <b>{{ stats.tables_changed }}</b></span>
    <span class="chip">共 <b>{{ changed_rows }}</b> 处变更</span>
  </div>
  <div class="toolbar">
    <label><input type="checkbox" id="only-changes"> 只看变更</label>
    <button id="prev">↑ 上一处</button>
    <button id="next">↓ 下一处</button>
    <span id="pos">- / {{ changed_rows }}</span>
  </div>
</header>

<div class="col-heads">
  <div></div>
  <div>{{ left_name }}（基准）</div>
  <div>{{ right_name }}（对比）</div>
</div>

<main id="view">
  {% for row in rows %}
  <div class="row kind-{{ row.kind }}{% if row.changed %} changed{% endif %}"
       {% if row.anchor %}id="{{ row.anchor }}"{% endif %}
       data-changed="{{ '1' if row.changed else '0' }}">
    <div class="gutter">
      <span class="no">{% if row.change_no %}{{ row.change_no }}{% endif %}</span>
      <span>{{ row.index }}</span>
    </div>
    <div class="cell left">{{ row.left|safe }}</div>
    <div class="cell right">{{ row.right|safe }}{{ row.fmt|safe }}</div>
  </div>
  {% endfor %}
  {% if not rows %}
  <div class="empty-note">文档中没有可比较的内容。</div>
  {% endif %}
</main>

<script>
(function () {
  var rows = Array.prototype.slice.call(document.querySelectorAll('.row'));
  var changed = rows.filter(function (r) { return r.dataset.changed === '1'; });
  var pos = document.getElementById('pos');
  var current = -1;
  var only = document.getElementById('only-changes');

  function total() { return changed.length; }

  function go(index) {
    if (!total()) return;
    current = (index + total()) % total();
    var target = changed[current];
    target.classList.add('flash');
    setTimeout(function () { target.classList.remove('flash'); }, 1200);
    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    pos.textContent = (current + 1) + ' / ' + total();
  }

  document.getElementById('next').addEventListener('click', function () { go(current + 1); });
  document.getElementById('prev').addEventListener('click', function () { go(current - 1); });

  only.addEventListener('change', function () {
    var hide = only.checked;
    rows.forEach(function (r) {
      if (hide && r.dataset.changed !== '1') r.classList.add('hidden');
      else r.classList.remove('hidden');
    });
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'j' || e.key === 'ArrowDown') { go(current + 1); }
    if (e.key === 'k' || e.key === 'ArrowUp') { go(current - 1); }
  });
})();
</script>
</body>
</html>

                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- Exception Interrupt Registers -->
          <register>
            <name>EIE</name>
            <description>MCPWM Exception Interrupt Control Register</description>
            <addressOffset>0x90</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>EIE</name>
                <description>Exception Interrupt Control</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <register>
            <name>EIF</name>
            <description>MCPWM Exception Interrupt Flag Register</description>
            <addressOffset>0x94</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>EIF</name>
                <description>Exception Interrupt Flags</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- DMA Request Control Register -->
          <register>
            <name>RE</name>
            <description>MCPWM DMA Request Control Register</description>
            <addressOffset>0x98</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>RE</name>
                <description>DMA Request Control</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- Push-Pull Mode Enable Register -->
          <register>
            <name>PP</name>
            <description>MCPWM Push-Pull Mode Enable Register</description>
            <addressOffset>0x9C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>PP</name>
                <description>Push-Pull Mode Enable</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- IO Control Registers -->
          <register>
            <name>IO01</name>
            <description>MCPWM CH0 CH1 IO Control Register</description>
            <addressOffset>0xA0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>IO01</name>
                <description>CH0 and CH1 IO Control</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <register>
            <name>IO23</name>
            <description>MCPWM CH2 CH3 IO Control Register</description>
            <addressOffset>0xA4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>IO23</name>
                <description>CH2 and CH3 IO Control</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <register>
            <name>IO45</name>
            <description>MCPWM CH4 CH5 IO Control Register</description>
            <addressOffset>0xA8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>IO45</name>
                <description>CH4 and CH5 IO Control</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- Address Alignment Padding -->
          <register>
            <name>RESERVED_AC</name>
            <description>Reserved for address alignment</description>
            <addressOffset>0xAC</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>RESERVED</name>
                <description>Reserved</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-only</access>
              </field>
            </fields>
          </register>

          <!-- Short Circuit Control Registers -->
          <register>
            <name>FAIL012</name>
            <description>MCPWM CH0 CH1 CH2 Short Circuit Control Register</description>
            <addressOffset>0xB0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>FAIL012</name>
                <description>CH0/1/2 Short Circuit Control</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <register>
            <name>FAIL345</name>
            <description>MCPWM CH3 CH4 CH5 Short Circuit Control Register</description>
            <addressOffset>0xB4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>FAIL345</name>
                <description>CH3/4/5 Short Circuit Control</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- Channel Default Output Register -->
          <register>
            <name>CH_DEF</name>
            <description>MCPWM Short Circuit Protection Channel Output Default Value</description>
            <addressOffset>0xB8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>CH_DEF</name>
                <description>Channel Output Default Value</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- Channel Mask Register -->
          <register>
            <name>CH_MSK</name>
            <description>MCPWM Channel Mask Register</description>
            <addressOffset>0xBC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>CH_MSK</name>
                <description>Channel Mask</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- Protection Register -->
          <register>
            <name>PRT</name>
            <description>MCPWM Protection Register</description>
            <addressOffset>0xC0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>PRT</name>
                <description>Protection Control</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- Status Stay Hysteresis Register -->
          <register>
            <name>STT_HYST</name>
            <description>MCPWM Status Stay Delay Register</description>
            <addressOffset>0xC8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>STT_HYST</name>
                <description>Status Stay Hysteresis</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- ZCS Status Delay Register -->
          <register>
            <name>ZCS_DELAY</name>
            <description>MCPWM ZCS Status Delay Register</description>
            <addressOffset>0xCC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>ZCS_DELAY</name>
                <description>ZCS Status Delay</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </registers>
    </peripheral>
    
    <!-- Added HWMATH Peripheral Node -->
    <peripheral>
      <name>HWMATH</name>
      <description>Hardware Mathematical Module, including square root, division, sine and cosine operation functions with status flags</description>
      <groupName>HWMATH</groupName>
      <prependToName>HWMATH_</prependToName>
      <baseAddress>0x40006000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x2C</size> <!-- 11 32-bit registers, total size: 11*4=44 bytes = 0x2C -->
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- 1. Version Identification Register -->
        <register>
          <name>VERID</name>
          <description>Version Identification Register, stores module version and feature information</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MINVN</name>
              <description>Minor Version Number</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MAJVN</name>
              <description>Major Version Number</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FEATURE</name>
              <description>Feature Identification Bit, indicates the operation functions supported by the module</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 2. Interrupt Request Register -->
        <register>
          <name>IR</name>
          <description>Interrupt Request Register, contains operation status flags and reserved bits</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SQRT_RDY</name>
              <description>Square Root Operation Ready Flag, 1 indicates operation completed</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RSV_1_3</name>
              <description>Reserved Bits, no actual function</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIVI_RDY</name>
              <description>Division Operation Ready Flag, 1 indicates operation completed</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIVI_ERR</name>
              <description>Division Operation Error Flag, 1 indicates division by zero or other errors</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RSV_6_7</name>
              <description>Reserved Bits, no actual function</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SINCOS_RDY</name>
              <description>Sine/Cosine Operation Ready Flag, 1 indicates operation completed</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RSV_9_31</name>
              <description>Reserved Bits, no actual function</description>
              <bitOffset>9</bitOffset>
              <bitWidth>23</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 3. Interrupt Enable Register -->
        <register>
          <name>IE</name>
          <description>Interrupt Enable Register (Reserved Bits)</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSV</name>
              <description>Reserved Bits, no actual function</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 4. Square Root Input Register -->
        <register>
          <name>SQRTRI</name>
          <description>Square Root Operation Input Register, stores 32-bit data to be square-rooted</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SQRTIN</name>
              <description>Square Root Input Data</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 5. Square Root Output Register -->
        <register>
          <name>SQRTRO</name>
          <description>Square Root Operation Result Output Register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SQRTOUT</name>
              <description>Square Root Operation Result (16-bit valid data)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RSV_16_31</name>
              <description>Reserved Bits</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 6. Division Dividend Register -->
        <register>
          <name>DIVIDE</name>
          <description>Division Operation Dividend Register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DIVIDE</name>
              <description>Division Operation Dividend</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 7. Division Divisor Register -->
        <register>
          <name>DIVIDS</name>
          <description>Division Operation Divisor Register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DIVIDS</name>
              <description>Division Operation Divisor</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 8. Division Quotient Register -->
        <register>
          <name>QUOTI</name>
          <description>Division Operation Quotient Register</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>QUOTI</name>
              <description>Division Operation Quotient Result</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 9. Division Remainder Register -->
        <register>
          <name>REMAIN</name>
          <description>Division Operation Remainder Register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>REMAIN</name>
              <description>Division Operation Remainder Result</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 10. Sine/Cosine Angle Input Register -->
        <register>
          <name>THETA</name>
          <description>Sine/Cosine Operation Angle Input Register</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ANGLE</name>
              <description>Input Angle Value (16-bit valid data)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RSV_16_31</name>
              <description>Reserved Bits</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 11. Sine/Cosine Result Register -->
        <register>
          <name>SINCOS</name>
          <description>Sine/Cosine Operation Result Output Register</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SIN</name>
              <description>Sine Operation Result (16-bit valid data)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>COS</name>
              <description>Cosine Operation Result (16-bit valid data)</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <!-- Added ADC Peripheral Node -->
    <peripheral>
      <name>ADC</name>
      <description>Analog-to-Digital Converter (ADC) Peripheral</description>
      <groupName>ADC</groupName>
      <prependToName>ADC_</prependToName>
      <baseAddress>0x40012400</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x9C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- VERID Register -->
        <register>
          <name>VERID</name>
          <description>Version Identification Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MINVN</name>

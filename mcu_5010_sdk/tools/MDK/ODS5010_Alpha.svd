              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- 注：数组 Reserved_110_3EC[184] 包含0x110~0x3EC共184个寄存器，上述仅列出第1个示例，其余按相同格式递增地址即可 -->

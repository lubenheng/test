                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- Status Stay Hysteresis Register -->
          <register>
            <name>STT_HYST</name>
            <description>MCPWM Status Stay Delay Register</description>
            <addressOffset>0xC8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>STT_HYST</name>
                <description>Status Stay Hysteresis</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>

          <!-- ZCS Status Delay Register -->
          <register>
            <name>ZCS_DELAY</name>
            <description>MCPWM ZCS Status Delay Register</description>
            <addressOffset>0xCC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>

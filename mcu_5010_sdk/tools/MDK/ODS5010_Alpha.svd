	<!-- Added FLASH Peripheral Node -->
    <peripheral>
      <name>FLASH</name>
      <description>Flash Memory Controller Peripheral</description>
      <groupName>FLASH</groupName>
      <prependToName>FLASH_</prependToName>
      <baseAddress>0x40022000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x100</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- Version ID Register (0x00) -->
        <register>
          <name>VERID</name>
          <description>Version ID Register (read only)</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MINVN</name>
              <description>Minor Version Number</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>MAJVN</name>
              <description>Major Version Number</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FEATURE</name>
              <description>Feature Identification</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- ACR Register (0x04) -->
        <register>
          <name>ACR</name>
          <description>Access Control Register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>NWS</name>
              <description>Number of Wait States</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED_3_31</name>
              <description>Reserved Bits 31-3</description>
              <bitOffset>3</bitOffset>
              <bitWidth>29</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- KEYR Register (0x08) -->
        <register>
          <name>KEYR</name>
          <description>Key Register (write only)</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
        </register>

        <!-- OPTKEYR Register (0x0C) -->
        <register>
          <name>OPTKEYR</name>
          <description>Option Key Register (write only)</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0</resetValue>

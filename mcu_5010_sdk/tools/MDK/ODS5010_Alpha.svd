        </register>
        
        <!-- 0x1C: Match Register -->
        <register>
          <name>MATCH</name>
          <description>Match Register</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MATCH</name>
              <description>Match Value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- 0x20: Reserved -->
        <register>
          <name>RESERVED_20</name>
          <description>Reserved</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
        </register>
        
        <!-- 0x24: Reserved -->
        <register>
          <name>RESERVED_24</name>
          <description>Reserved</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
        </register>
        
        <!-- 0x28: Reserved -->
        <register>
          <name>RESERVED_28</name>
          <description>Reserved</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
        </register>
        
        <!-- 0x2C: Watermark Register -->
        <register>
          <name>WATER</name>
          <description>Watermark Register</description>
          <addressOffset>0x2C</addressOffset>
          <size>32</size>
          <access>read-write</access>

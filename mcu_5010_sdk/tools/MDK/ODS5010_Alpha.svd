	<!-- Added SYSCFG Peripheral Node -->
    <peripheral>
      <name>SYSCFG</name>
      <description>System Configuration (SYSCFG) Peripheral</description>
      <groupName>SYSCFG</groupName>
      <prependToName>SYSCFG_</prependToName>
      <baseAddress>0x40020400</baseAddress> <!-- 与syscfg_reg.txt中SYSCFG_BASE一致 -->
      <addressBlock>
        <offset>0x0000</offset>
        <size>0x0400</size> <!-- 覆盖0x00~0x3FC地址范围 -->
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- 0x00: UUID0 Register -->
        <register>
          <name>UUID0</name>
          <description>UUID Register 0</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>UUID0</name>
              <description>UUID Value 0</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- 0x04: UUID1 Register -->
        <register>
          <name>UUID1</name>
          <description>UUID Register 1</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>UUID1</name>
              <description>UUID Value 1</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- 0x08: UUID2 Register -->

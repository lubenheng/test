              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- 0x110: Reserved_110 Register (数组第1个元素) -->
        <register>
          <name>Reserved_110</name>
          <description>Reserved Register</description>
          <addressOffset>0x110</addressOffset>
          <size>32</size>
          <access>read-only</access>

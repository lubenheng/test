	<!-- Added SPI0 Peripheral Node -->
	 <peripheral>
      <name>SPI0</name>
      <description>Serial Peripheral Interface (SPI0) Peripheral</description>
      <groupName>SPI0</groupName>
      <prependToName>SPI_0</prependToName>
      <baseAddress>0x40003800</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x100</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- CTRLR0 Register -->
        <register>

                <bitWidth>16</bitWidth>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </registers>
    </peripheral>

    <!-- Added MCPWM Peripheral Node -->
    <peripheral>
        <name>MCPWM</name>
        <description>Motor Control PWM</description>
        <groupName>MCPWM</groupName>
        <prependToName>MCPWM_</prependToName>

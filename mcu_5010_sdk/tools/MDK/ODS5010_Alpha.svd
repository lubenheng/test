        <!-- 注：数组 Reserved_40_FC[48] 包含0x40~0xFC共48个寄存器，上述仅列出前3个示例，其余按相同格式递增地址即可 -->
        <!-- 以下省略0x4C~0xF8共42个 Reserved 寄存器，格式与上述一致，地址按0x04递增 -->

        <!-- 0xFC: Reserved_FC Register (数组第48个元素) -->
        <register>
          <name>Reserved_FC</name>
          <description>Reserved Register</description>
          <addressOffset>0xFC</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Reserved_FC</name>
              <description>Reserved Value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- 0x100: WAKEIR Register -->
        <register>
          <name>WAKEIR</name>
          <description>Wake-Up Interrupt Register</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>WAKEIR</name>
              <description>Wake-Up Interrupt Value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 0x104: WAKECR Register -->
        <register>
          <name>WAKECR</name>
          <description>Wake-Up Control Register</description>
          <addressOffset>0x104</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>WAKECR</name>
              <description>Wake-Up Control Value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 0x108: LPTMRTH Register (原文件中变量名重复为WAKECR，已修正为LPTMRTH) -->
        <register>
          <name>LPTMRTH</name>
          <description>Low-Power Timer Threshold Register</description>
          <addressOffset>0x108</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LPTMRTH</name>
              <description>Low-Power Timer Threshold Value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- 0x10C: Reserved_10C Register -->
        <register>
          <name>Reserved_10C</name>
          <description>Reserved Register</description>
          <addressOffset>0x10C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
